# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
# v13 stage 3b: react-router build writes build/client + build/server, and the
# Vercel preset writes .vercel/react-router-build-result.json for the platform
# builder. .react-router/ is the generated-types cache.
build/
.react-router/
.vercel/

# Environment files
.env
.env.local
.env.production

# Local MCP config (project-specific server config; secrets via env var)
.mcp.json

# Editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Vitest
coverage/
supabase/.temp/

# Deno (Edge Function local typecheck cache; Supabase CLI handles deps at deploy time)
deno.lock

# Claude Code runtime state (per-machine, not project state)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Playwright E2E
tests/e2e/.auth/
playwright-report/
test-results/

# Rendered video outputs (regenerable from the HyperFrames source — keep big binaries out of git)
marketing/video/**/*.mp4
marketing/video/**/*.wav

# canon→Drive sync scratch (gws --upload needs cwd-local temp)
.canon-sync-tmp/

# Untracked working artefacts — audit scratch, design explorations, generated
# marketing content and binary docs. Regenerable; not project state.
#
# These were accidentally committed on 2026-07-30 by a `git add -A` that ran before
# these rules existed, then untracked in the follow-up. .gitignore does NOT untrack
# an already-tracked file — if you add a rule here for something already committed,
# you must also `git rm --cached` it.
.tmp-audit/
# docs/design is scratch EXCEPT the committed contrast artefact (Phase 4.1) —
# `docs/design/` (dir form) would make the negation impossible, hence `/*`.
docs/design/*
!docs/design/contrast.md
!docs/design/phase-5-ledger.md
# v13: the directive governs the port and is the decision record. Tracked, not scratch.
!docs/design/v11-DIRECTIVE.md
# v12: supersedes v11 for the marketing surface, and is cited by CLAUDE.md section 10. The
# approved comp travels with it — a directive that cites a reference nobody can open is half
# a record, and this one is the authority the build was reproduced against.
!docs/design/v12-DIRECTIVE.md
!docs/design/design-reference/
docs/design/design-reference/*
!docs/design/design-reference/topfarming landing concept 3.png
content/
.claude/skills/playwright-skill/
docs/index.docx
docs/_canonical/*.docx
