# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment files
.env
.env.local
.env.production

# Local MCP config (project-specific server config; secrets via env var)
.mcp.json

# Editor
.DS_Store
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Vitest
coverage/
supabase/.temp/

# Deno (Edge Function local typecheck cache; Supabase CLI handles deps at deploy time)
deno.lock

# Claude Code runtime state (per-machine, not project state)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Playwright E2E
tests/e2e/.auth/
playwright-report/
test-results/

# Rendered video outputs (regenerable from the HyperFrames source — keep big binaries out of git)
marketing/video/**/*.mp4
marketing/video/**/*.wav

# canon→Drive sync scratch (gws --upload needs cwd-local temp)
.canon-sync-tmp/

# Untracked working artefacts — audit scratch, design explorations, generated
# marketing content and binary docs. Regenerable; not project state.
#
# These were accidentally committed on 2026-07-30 by a `git add -A` that ran before
# these rules existed, then untracked in the follow-up. .gitignore does NOT untrack
# an already-tracked file — if you add a rule here for something already committed,
# you must also `git rm --cached` it.
.tmp-audit/
# docs/design is scratch EXCEPT the committed contrast artefact (Phase 4.1) —
# `docs/design/` (dir form) would make the negation impossible, hence `/*`.
docs/design/*
!docs/design/contrast.md
content/
.claude/skills/playwright-skill/
docs/index.docx
docs/_canonical/*.docx
